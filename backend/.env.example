PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/archng?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/archng_test?schema=public
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
EMAIL_DRIVER=console
EMAIL_FROM=ArchNG <no-reply@archng.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_API_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=archng
SEED_ADMIN_EMAIL=admin@archng.test
SEED_ADMIN_PASSWORD=Password123!
SEED_DEMO_PASSWORD=Password123!
